{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "endOfLine": "lf",
  "arrowParens": "avoid",
  "objectWrap": "collapse",
  "semi": false,
  "sortImports": true,
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "dist-preview/",
    "local/",
    "public/ocr/",
    "public/bis/",
    "tools/bis/",
    "public/locales/manifest.json",
    ".agents/",
    "*.log",
    "*.traineddata"
  ]
}
